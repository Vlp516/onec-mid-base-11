
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ++ Дз13 07.09.26 (Добаление реквизита КонтактноеЛицо на форму документа)
	ЭлементРСК_КонтактноеЛицо = Элементы.Вставить("РСК_КонтактноеЛицо", Тип("ПолеФормы"), Элементы.ГруппаШапкаПраво, Элементы.Договор);
	ЭлементРСК_КонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементРСК_КонтактноеЛицо.ПутьКДанным = "Объект.РСК_КонтактноеЛицо";
	// -- Дз13 07.09.26 (Добаление реквизита КонтактноеЛицо на форму документа)
	
	
	// ++ Дз13 07.09.26 (Добаление реквизита РСК_СогласованнаяСкидка и команды Пересчитать на форму документа)
	ЭлементРСК_СогласованнаяСкидка = Элементы.Вставить("РСК_СогласованнаяСкидка", Тип("ПолеФормы"), Элементы.ГруппаШапкаЛево);
	ЭлементРСК_СогласованнаяСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементРСК_СогласованнаяСкидка.ПутьКДанным = "Объект.РСК_СогласованнаяСкидка";
	
	ГруппаСкидка = Элементы.Вставить("ГруппаРСК_СогласованнаяСкидка", Тип("ГруппаФормы"),
	    	Элементы.РСК_СогласованнаяСкидка.Родитель, Элементы.РСК_СогласованнаяСкидка);
	ГруппаСкидка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаСкидка.ОтображатьЗаголовок = Ложь;
    //ГруппаСкидка.Отображение = ОтображениеОбычнойГруппы.Нет;
    ГруппаСкидка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;

	Элементы.Удалить(Элементы.РСК_СогласованнаяСкидка);
       
	ЭлементСкидка = Элементы.Вставить("РСК_СогласованнаяСкидка", Тип("ПолеФормы"), ГруппаСкидка);
	ЭлементСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСкидка.ПутьКДанным = "Объект.РСК_СогласованнаяСкидка";
	ЭлементСкидка.УстановитьДействие("ПриИзменении", "СогласованнаяСкидкаПриИзменении");

    КомандаПересчитать = Команды.Добавить("ПересчитатьСкидку");
    КомандаПересчитать.Действие = "ПересчитатьСтрокиТЧ";
    КнопкаПересчитать = Элементы.Добавить("ПересчитатьСкидкуКнопка", Тип("КнопкаФормы"), ГруппаСкидка);

	КнопкаПересчитать.Картинка = БиблиотекаКартинок.Перечитать;
	КнопкаПересчитать.Отображение = ОтображениеКнопки.КартинкаИТекст;
	                                                           
	КнопкаПересчитать.ИмяКоманды = "ПересчитатьСкидку";
    КнопкаПересчитать.Заголовок  = "Пересчитать";
	// -- Дз13 07.09.26 (Добаление реквизита РСК_СогласованнаяСкидка и команды Пересчитать на форму документа)
	
КонецПроцедуры

