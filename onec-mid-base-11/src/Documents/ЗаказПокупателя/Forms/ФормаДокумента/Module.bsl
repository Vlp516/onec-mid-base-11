#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// ++ Дз13 07.09.26 (Расчет СуммыСироки с учетом Согласованной скидки)
	ОбщаяСкидка = ТекущиеДанные.Скидка + Объект.РСК_СогласованнаяСкидка;
	
	Если ОбщаяСкидка > 100 Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ("Размер скидки превышает 100%");
		Сообщение.Сообщить();
	
		ТекущиеДанные.Скидка = 0;
		ОбщаяСкидка = ТекущиеДанные.Скидка + Объект.РСК_СогласованнаяСкидка;
		
	КонецЕсли;
		
		КоэффициентСкидки = 1 - ОбщаяСкидка / 100;
		ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	// -- Дз13 07.09.26 (Расчет СуммыСироки с учетом Согласованной скидки)
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

// ++ Дз13 07.09.26 (Расчет СуммыСироки с учетом Согласованной скидки)

&НаКлиенте
Асинх Процедура СогласованнаяСкидкаПриИзменении(Элемент)

	Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать таблицы товаров и услуг?", РежимДиалогаВопрос.ДаНет);
	ОтветНаВопрос = Ждать Вопрос;
	
	Если ОтветНаВопрос <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	
	ПересчитатьСтрокиТЧ();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокиТЧ()

	МаксСкидкаТовары = 0;
	МаксСкидкаУслуги = 0;

	Для каждого Строка Из Объект.Товары Цикл
		
		Если Строка.Скидка > МаксСкидкаТовары Тогда
			
			МаксСкидкаТовары = Строка.Скидка;
			
		КонецЕсли;

	КонецЦикла;

	Для каждого Строка Из Объект.Услуги Цикл
		
		Если Строка.Скидка > МаксСкидкаУслуги Тогда
			
			МаксСкидкаУслуги = Строка.Скидка;
			
		КонецЕсли;
		
	КонецЦикла;

	Если МаксСкидкаУслуги > МаксСкидкаТовары Тогда
		
		МаксимальнаяСкидка = МаксСкидкаУслуги;
		
	Иначе
		
		МаксимальнаяСкидка = МаксСкидкаТовары;
		
	КонецЕсли;

	Если МаксимальнаяСкидка + Объект.РСК_СогласованнаяСкидка > 100 Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ("Размер скидки превышает 100%");
		Сообщение.Сообщить();
		Объект.РСК_СогласованнаяСкидка = 0;
		
	КонецЕсли;
	
	Для Каждого Строка Из Объект.Товары Цикл
		
		РассчитатьСуммуСтроки(Строка);
		
	КонецЦикла; 
	
    Для Каждого Строка Из Объект.Услуги Цикл
		
		РассчитатьСуммуСтроки(Строка);
		
	КонецЦикла;       

КонецПроцедуры

// -- Дз13 07.09.26 (Расчет СуммыСироки с учетом Согласованной скидки)


